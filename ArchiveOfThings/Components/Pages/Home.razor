@page "/"
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

@if (Session.IsLoggedIn)
{
    <header class="mb-6 border-b border-line pb-3.5">
        <h1 class="font-heading text-[1.9rem] font-semibold text-brand">Dashboard</h1>
        <p class="mt-1.5 text-sm text-muted">Overview of your archive</p>
    </header>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) Nav.NavigateTo("login");
    }
}
