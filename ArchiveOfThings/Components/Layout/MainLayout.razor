@inherits LayoutComponentBase
@inject SessionState Session
@inject NavigationManager Nav

<div class="min-h-screen md:grid md:grid-cols-[240px_minmax(0,1fr)]">
    <aside class="fixed inset-x-0 bottom-0 z-40 flex h-[60px] items-center gap-3 border-t border-line bg-bar px-3 md:sticky md:top-0 md:h-screen md:flex-col md:items-stretch md:gap-0 md:border-t-0 md:border-r md:py-5">
        <div class="hidden px-2 pb-5 font-heading text-[1.05rem] font-semibold text-brand md:block">ArchiveOfThings</div>
        <nav class="flex flex-1 flex-row gap-0.5 md:flex-none md:flex-col" aria-label="Main">
            <NavLink class="rounded-md border-l-2 border-transparent px-2.5 py-2 text-[.92rem] hover:bg-white/5 [&.active]:border-brand [&.active]:bg-card" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        </nav>
        <div class="flex items-center gap-2.5 md:mt-auto md:border-t md:border-line md:pt-3">
            <div class="grid size-8 flex-none place-items-center rounded-md bg-brand/15 font-semibold text-brand">@Session.Initial</div>
            <div class="hidden text-sm md:block">
                <div>@Session.Username</div>
                <div class="text-muted">Admin</div>
            </div>
            <button class="ml-auto cursor-pointer rounded-md border border-line-strong px-2.5 py-1 text-[.8rem] text-muted hover:border-brand hover:text-fg" @onclick="SignOut">Sign out</button>
        </div>
    </aside>
    <main class="min-w-0 px-4 pt-5 pb-24 md:px-10 md:pt-8 md:pb-12">@Body</main>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden bg-[#3a1d20] px-4 py-2.5" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline">Reload</a>
    <span class="absolute top-2.5 right-3 cursor-pointer">🗙</span>
</div>

@code {
    void SignOut()
    {
        Session.SignOut();
        Nav.NavigateTo("login");
    }
}
